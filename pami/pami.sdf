<?xml version="1.0"?>
<?xml-model href="https://sdformat.org/schemas/root.xsd" type="application/xml"?>

<sdf version="1.12">
	<model name="pami">
		<link name="chassis">
			<pose relative_to='__model__'>0 0 0.01205 0 0 0</pose>
			<collision name="col">
				<geometry>
					<box>
						<size>0.030 0.065 0.015</size>
					</box>
				</geometry>
			</collision>
			<visual name="vis">
				<geometry>
					<box>
						<size>0.030 0.065 0.015</size>
					</box>
				</geometry>
				<material>
					<ambient>0.0 0.0 1.0 1</ambient>
					<diffuse>0.0 0.0 1.0 1</diffuse>
					<specular>0.0 0.0 1.0 1</specular>
				</material>
			</visual>
			<inertial>
				<!-- 10g + 50g + 30g ~ 100g -->
				<mass>0.1</mass>
				<inertia>
					<ixx>3.5E-05</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>8E-06</iyy>
					<iyz>0</iyz>
					<izz>4.3E-05</izz>
				</inertia>
			</inertial>
		</link>

		<link name='left_wheel'>
			<!-- <pose relative_to="chassis">-0.009 0.040 0.00045 -1.5707 0 0</pose> -->
			<pose relative_to="__model__">-0.009 0.040 0.0125 -1.5707 0 0</pose>
			<inertial>
				<mass>0.005</mass>
				<inertia>
					<ixx>0.0001</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>0.0001</iyy>
					<iyz>0</iyz>
					<izz>0.0001</izz>
				</inertia>
			</inertial>
			<visual name='visual'>
				<geometry>
					<cylinder>
						<radius>0.0125</radius>
						<length>0.005</length>
					</cylinder>
				</geometry>
				<material>
					<ambient>1.0 0.0 0.0 1</ambient>
					<diffuse>1.0 0.0 0.0 1</diffuse>
					<specular>1.0 0.0 0.0 1</specular>
				</material>
			</visual>
			<collision name='collision'>
				<geometry>
					<cylinder>
						<radius>0.0125</radius>
						<length>0.005</length>
					</cylinder>
				</geometry>
			</collision>
		</link>

		<link name='right_wheel'>
			<!-- <pose relative_to="chassis">-0.009 0.040 0.00045 -1.5707 0 0</pose> -->
			<pose relative_to="__model__">-0.009 -0.040 0.0125 1.5707 0 0</pose>
			<inertial>
				<mass>0.005</mass>
				<inertia>
					<ixx>0.0001</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>0.0001</iyy>
					<iyz>0</iyz>
					<izz>0.0001</izz>
				</inertia>
			</inertial>
			<visual name='visual'>
				<geometry>
					<cylinder>
						<radius>0.0125</radius>
						<length>0.005</length>
					</cylinder>
				</geometry>
				<material>
					<ambient>1.0 0.0 0.0 1</ambient>
					<diffuse>1.0 0.0 0.0 1</diffuse>
					<specular>1.0 0.0 0.0 1</specular>
				</material>
			</visual>
			<collision name='collision'>
				<geometry>
					<cylinder>
						<radius>0.0125</radius>
						<length>0.005</length>
					</cylinder>
				</geometry>
			</collision>
		</link>

		<link name='patin'>
			<!-- <pose relative_to="chassis">-0.009 0.040 0.00045 -1.5707 0 0</pose> -->
			<pose relative_to="__model__">0.014 0 0.0025 1.5707 0 0</pose>
			<inertial>
				<mass>0.005</mass>
				<inertia>
					<ixx>0.0001</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>0.0001</iyy>
					<iyz>0</iyz>
					<izz>0.0001</izz>
				</inertia>
			</inertial>
			<visual name='visual'>
				<geometry>
					<sphere>
						<radius>0.0025</radius>
					</sphere>
				</geometry>
				<material>
					<ambient>1.0 1.0 0.0 1</ambient>
					<diffuse>1.0 1.0 0.0 1</diffuse>
					<specular>1.0 1.0 0.0 1</specular>
				</material>
			</visual>
			<collision name='collision'>
				<geometry>
					<sphere>
						<radius>0.0025</radius>
					</sphere>
				</geometry>
			</collision>
		</link>

		<joint name="chassis-patin" type="ball">
			<pose relative_to='patin' />
			<parent>chassis</parent>
			<child>patin</child>
		</joint>

		<joint name="chassis-wl" type="revolute">
			<pose relative_to='left_wheel' />
			<parent>chassis</parent>
			<child>left_wheel</child>
			<axis>
				<xyz>0 0 1</xyz> <!--can
				be defined as any frame or even arbitrary frames-->
			</axis>
		</joint>

		<joint name="chassis-wr" type="revolute">
			<pose relative_to='right_wheel' />
			<parent>chassis</parent>
			<child>right_wheel</child>
			<axis>
				<xyz>0 0 1</xyz> <!--can
				be defined as any frame or even arbitrary frames-->
			</axis>
		</joint>
	</model>
</sdf>
